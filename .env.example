# Copy to .env.local for local dev. Never commit real values.

# Used by npm run db:push / db:seed only, never bundled into the app.
# Supabase → Connect → Transaction pooler connection string (port 6543),
# with [YOUR-PASSWORD] replaced by the database password
DATABASE_URL=

# Read by the app. Supabase → Connect → Mobile frameworks → Expo React Native
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
