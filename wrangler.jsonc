// Cloudflare Worker for powerliftingnotebook.com: serves the static site in
// website/ (/privacy serves privacy.html), and worker/index.js handles /api/
// routes that aren't files.
{
  "name": "powerlifting-notebook",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "assets": {
    "directory": "./website",
    "binding": "ASSETS"
  }
}
